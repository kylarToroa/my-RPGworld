{
  "name": "my-rpgworld",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "以像素 RPG 形式呈现的个人网站",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "typecheck": "tsc --noEmit",
    "gen:art": "node scripts/generate-placeholder-art.mjs",
    "gen:maps": "node scripts/generate-maps.mjs",
    "gen:m2maps": "node scripts/build-m2-maps.mjs",
    "sync:assets": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.1.3",
    "phaser": "^3.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
